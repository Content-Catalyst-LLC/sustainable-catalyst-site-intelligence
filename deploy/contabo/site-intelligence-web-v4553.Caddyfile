intelligence.sustainablecatalyst.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8096
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), camera=(), microphone=()"
        Content-Security-Policy "default-src 'self'; connect-src 'self' https://site-intelligence-api.sustainablecatalyst.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'self' https://sustainablecatalyst.com"
    }
}
