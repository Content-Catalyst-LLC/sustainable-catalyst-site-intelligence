# Development only. Generate fresh secrets; never copy production credentials.
SC_SI_ENVIRONMENT=development
SC_SI_DEMO_MODE=false
SC_SI_API_TOKEN=GENERATE_UNIQUE_SECRET
SC_SI_PLATFORM_CORE_ENABLED=true
SC_SI_PLATFORM_CORE_URL=http://sc-core:8090
SC_SI_PLATFORM_CORE_WRITE_API_KEY=GENERATE_UNIQUE_SECRET
SC_SI_WEB_APP_URL=http://localhost:8091
SC_SI_PUBLIC_API_URL=http://localhost:8091
SC_SI_CORS_ORIGINS=http://localhost:8081,http://localhost:8091
SC_SI_GA4_PROPERTY_ID=
SC_SI_GOOGLE_APPLICATION_CREDENTIALS_FILE=
SC_SI_GOOGLE_APPLICATION_CREDENTIALS_JSON=
SC_SI_SEARCH_CONSOLE_LIVE=false
SC_SI_SITEMAP_LIVE=false
SC_SI_AI_PROVIDER=disabled
SC_DEV_WP_NETWORK=existing-wordpress-private-network
