    "/dossiers/:country": "dossiers",
    "/economics/:country": "economics",
    "/law/:country": "law",
    "/science/:country": "science",
    "/science/earth/:country": "science",
    "/humanitarian/:country": "humanitarian",
    "/resources/:country": "resources",
    "/events": "events",
    "/research": "research",
    "/packages/:package_id?": "research"
  },
  "required_workspaces": [
    "overview",
    "global",
    "economics",
    "law",
    "science",
    "humanitarian",
    "resources",
    "dossiers",
    "alerts",
    "scenarios",
    "research",
    "integration",
    "experience",
    "earth",
    "spatial",
    "harmonization",
    "models",
    "evidence",
    "graph",
    "publishing",
    "monitoring",
    "workspaces",
    "workflows",
    "federation",
    "governance",
    "country",
    "events",
    "compare",
    "thematic",
    "briefing",
    "sources",
    "saved",
    "observatory"
  ],
  "functional_controls": [
    "primary-navigation",
    "country-selector",
    "map-layer-controls",
    "event-filters",
    "domain-filters",
    "save-view",
    "share-view",
    "evidence-drawer",
    "advanced-research",
    "research-handoffs",
    "export-controls",
    "browser-history"
  ],
  "certification": {
    "http_200_is_not_functional_pass": true,
    "browser_interaction_required": true,
    "real_api_state_required_in_production": true,
    "degraded_states_visible": true,
    "no_demo_records": true
  }
}
