  "version": "4.56.1",
  "release_name": "Standalone Functional Parity Recovery",
  "authority": {
    "web_origin": "https://intelligence.sustainablecatalyst.com",
    "api_origin": "https://site-intelligence-api.sustainablecatalyst.com",
