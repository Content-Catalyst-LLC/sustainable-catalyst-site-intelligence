  "federation_plan_schema": "sc-site-intelligence-source-federation-plan/1.0",
  "trust_evaluation_schema": "sc-site-intelligence-source-trust-evaluation/1.0",
  "scope_types": [
    "global",
    "regional",
    "country",
    "multinational"
  ],
  "federation_modes": [
    "live",
    "discovery",
    "auth-required",
    "registered",
    "reference"
  ],
  "authority_classes": [
    {
      "id": "national-statistical-authority",
      "authority_rank": 100,
      "description": "First-party national statistical authority within its published jurisdiction and semantic scope."
    },
    {
      "id": "official-sector-authority",
      "authority_rank": 95,
      "description": "First-party public sector, operational, scientific, or administrative authority for a defined domain."
    },
    {
      "id": "regional-statistical-authority",
      "authority_rank": 93,
      "description": "Official regional statistical authority operating across a defined multinational region."
    },
    {
      "id": "intergovernmental-custodian",
      "authority_rank": 90,
      "description": "Intergovernmental organization acting as custodian or first-party publisher for a defined international dataset or operational service."
    },
    {
      "id": "international-harmonized",
      "authority_rank": 80,
      "description": "Cross-country harmonized source suitable for comparable statistics when semantic compatibility is preserved."
    },
    {
      "id": "scientific-observatory",
      "authority_rank": 80,
      "description": "Scientific observation or research data authority with explicit source and methodology boundaries."
    },
    {
      "id": "regulatory-authority",
      "authority_rank": 80,
      "description": "Regulatory or compliance authority within its legal scope."
    },
    {
      "id": "research-consortium",
      "authority_rank": 65,
      "description": "Research or community scientific consortium; authority depends on the supplied dataset and methodology."
    },
    {
      "id": "humanitarian-coordination",
      "authority_rank": 65,
      "description": "Humanitarian coordination/discovery source preserving publisher-level attribution and verification boundaries."
    },
    {
      "id": "open-community-supplemental",
      "authority_rank": 45,
      "description": "Open/community source used as supplemental context and never silently elevated above official exact-concept evidence."
    }
  ],
