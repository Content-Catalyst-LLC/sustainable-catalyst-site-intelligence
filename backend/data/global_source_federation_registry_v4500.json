  "selection_policy": {
    "order": [
      "semantic-compatibility",
      "declared-jurisdiction-precedence",
      "jurisdiction-specificity",
      "authority-class",
      "freshness",
      "record-status",
      "stable-source-id"
    ],
    "semantic_compatibility_required": true,
    "user_trust_can_filter": true,
    "user_trust_changes_authority_rank": false,
    "network_calls_performed": false,
    "notes": [
      "A fresher record for the wrong metric or concept is never preferred over semantically compatible evidence.",
      "National or sector authority precedence applies only within the source's actual jurisdiction and domain.",
      "International harmonized series remain useful for cross-country comparison and fallback when exact-concept higher-precedence evidence is unavailable.",
      "User trust choices are filters/preferences, not a rewrite of source authority, quality, or provenance."
    ]
  },
  "trust_policy": {
    "separate_from_authority": true,
    "separate_from_quality": true,
    "default_profile": "neutral-no-source-blocks",
    "supported_filters": [
      "allowed_source_ids",
      "blocked_source_ids",
      "allowed_authority_classes",
      "allowed_federation_modes"
    ]
  },
